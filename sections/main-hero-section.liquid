
{% render 'section-styles', section: section %}

 {{ 'hero.css' | asset_url | stylesheet_tag }}



<section class="hero-section">

    <div class="hero-inner">

        <div class="hero-left">

        <div class="hero-left-content">
                        <h1>{{section.settings.hero_text}} <span>{{section.settings.hero_text_italic}}</span></h1>

<div class="hero-btn-wrap">

    <a href="{{section.settings.first_btn_url}}" class="btn-fill">{{section.settings.first_btn_text}}</a>
    <a href="{{section.settings.second_btn_url}}" class="btn-outline">{{section.settings.second_btn_text}}</a>

</div>
        </div>

        </div>

        <div class="hero-right">

 <img
  src="{{ section.settings.hero_img | image_url: width: 2000 }}"
  alt=""
  class="desktop-hero-img"
  fetchpriority="high"
  loading="eager"
>

<img
  src="{{ section.settings.hero_img_for_mobile | image_url: width: 1000 }}"
  alt=""
  class="mobile-hero-img"
  loading="lazy"
>

        </div>

    </div>

</section>



{% schema  %} 
{
    "name": "Hero section",
    "limit": 1,
    "settings": [


    {
        "type": "header",
        "content": "Hero section text content"
    },

    {
        "type": "text",
        "id": "hero_text",
        "default": "Hydration, energy, and performance",
        "label": "Add hero text",
        "placeholder": "Write here..."
    },

     {
        "type": "text",
        "id": "hero_text_italic",
        "default": "one scoop",
        "label": "Add hero highlighted text",
        "placeholder": "Write here..."
    },
    {
      "type": "header",
       "content": "Hero button settings",
    },
    {
      "type": "text",
      "id": "first_btn_text",
      "default": "Shop Electrolytes",
      "label": "Add first button text here"
    },
    {
      "type": "url",
       "id": "first_btn_url",
       "label": "Set first button url"
    },

     {
      "type": "text",
      "id": "second_btn_text",
      "default": "Shop Electrolytes",
      "label": "Add second button text here"
    },
    {
      "type": "url",
       "id": "second_btn_url",
       "label": "Set second button url"
    },

{
      "type": "image_picker",
      "label": "Set hero img",
      "id": "hero_img"
    },

    {
      "type": "image_picker",
      "label": "Set hero img for mobile",
      "id": "hero_img_for_mobile"
    },

    


        {
        "type": "header",
        "content": "Spacing"
      },
      {
        "type": "range",
        "id": "padding_top",
        "label": "Padding top (desktop)",
        "min": 0, "max": 200, "step": 4, "unit": "px", "default": 0
      },
      {
        "type": "range",
        "id": "padding_bottom",
        "label": "Padding bottom (desktop)",
        "min": 0, "max": 200, "step": 4, "unit": "px", "default": 0
      },
      {
        "type": "range",
        "id": "padding_top_mobile",
        "label": "Padding top (mobile)",
        "min": 0, "max": 200, "step": 4, "unit": "px", "default": 0
      },
      {
        "type": "range",
        "id": "padding_bottom_mobile",
        "label": "Padding bottom (mobile)",
        "min": 0, "max": 200, "step": 4, "unit": "px", "default": 0
      },
      {
        "type": "header",
        "content": "Background"
      },
      {
        "type": "select",
        "id": "bg_type",
        "label": "Background type",
        "options": [
          { "value": "none", "label": "None" },
          { "value": "color", "label": "Color" },
          { "value": "gradient", "label": "Gradient" },
          { "value": "image", "label": "Image" }
        ],
        "default": "none"
      },
      {
        "type": "color",
        "id": "bg_color",
        "label": "Background color",
        "default": "#FDF6F4",
        "visible_if": "{{ section.settings.bg_type == 'color' }}"
      },
      {
        "type": "color_background",
        "id": "bg_gradient",
        "label": "Background gradient",
        "visible_if": "{{ section.settings.bg_type == 'gradient' }}"
      },
      {
        "type": "image_picker",
        "id": "bg_image",
        "label": "Background image",
        "visible_if": "{{ section.settings.bg_type == 'image' }}"
      }



    ],
    "blocks": [],
    "presets": [
        {
            "name": "Hero section"
        }
    ]
}

{% endschema %}

