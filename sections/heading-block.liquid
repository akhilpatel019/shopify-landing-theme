{% render 'section-styles', section: section %}

 {{ 'heading.css' | asset_url | stylesheet_tag }}






<section class="heading-section">
    <div class="heading-wrapper page_width">
        <h2 class="section_heading_small">
            {{
                section.settings.add_your_heading
            }}
        </h2>
    </div>
</section>



{% schema %}
{
  "name": "Heading section",
  "settings": [
    {
      "type": "text",
      "label": "Add your Heading",
      "id": "add_your_heading",
      "default": "Heading"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top (desktop)",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 12
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom (desktop)",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 12
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Padding top (mobile)",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 8
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Padding bottom (mobile)",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 8
    },
    {
      "type": "header",
      "content": "Background"
    },
    {
      "type": "select",
      "id": "bg_type",
      "label": "Background type",
      "options": [
        { "value": "none", "label": "None" },
        { "value": "color", "label": "Color" },
        { "value": "gradient", "label": "Gradient" },
        { "value": "image", "label": "Image" }
      ],
      "default": "none"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background color",
      "default": "#1D0930",
      "visible_if": "{{ section.settings.bg_type == 'color' }}"
    },
    {
      "type": "color_background",
      "id": "bg_gradient",
      "label": "Background gradient",
      "visible_if": "{{ section.settings.bg_type == 'gradient' }}"
    },
    {
      "type": "image_picker",
      "id": "bg_image",
      "label": "Background image",
      "visible_if": "{{ section.settings.bg_type == 'image' }}"
    }
  ],
  "blocks": [],
  "presets": [
    {
      "name": "Heading section"
    }
  ]
}
{% endschema %}

