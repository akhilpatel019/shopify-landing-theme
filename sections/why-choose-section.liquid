{% render 'section-styles', section: section %}

{{ 'why.css' | asset_url | stylesheet_tag }}

<section class="why-c-section">
  <div class="page_width why-c-wrapper">
    <div class="why-left">
      {% if section.settings.section_image != blank %}
        {{ section.settings.section_image | image_url: width: 600 | image_tag: alt: section.settings.section_title }}
      {% endif %}
    </div>

    <div class="why-right">
      <div class="why-header">
        {% assign title = section.settings.section_title %}
        {% assign italic_word = section.settings.italic_word %}

        {% if italic_word != blank %}
          {% capture italic_tag %}<em>{{ italic_word }}</em>{% endcapture %}
          {% assign italic_title = title | replace: italic_word, italic_tag %}
        {% else %}
          {% assign italic_title = title %}
        {% endif %}

        <h2 class="section_header_title">
          {{ italic_title }}
        </h2>

        <p>{{ section.settings.section_desc }}</p>
      </div>

      <div class="why-points-wrapper">
        {% for block in section.blocks %}
          {% if block.type == 'why_point' %}
            <div class="why-point" {{ block.shopify_attributes }}>
              <h3>{{ block.settings.point_title }}</h3>
              <p>{{ block.settings.point_desc }}</p>
            </div>
          {% endif %}
        {% endfor %}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Why Choose Section",
  "settings": [
    {
      "type": "image_picker",
      "id": "section_image",
      "label": "Add images"
    },

    {
      "type": "text",
      "default": "Why choose us",
      "id": "section_title",
      "label": "Add section title"
    },

    {
      "type": "text",
      "default": "Why",
      "id": "italic_word",
      "label": "Word to make italic"
    },

    {
      "type": "text",
      "id": "section_desc",
      "default": "Description......",
      "label": "Add Description"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top (desktop)",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 12
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom (desktop)",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 12
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Padding top (mobile)",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 8
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Padding bottom (mobile)",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 8
    },
    {
      "type": "header",
      "content": "Background"
    },
    {
      "type": "select",
      "id": "bg_type",
      "label": "Background type",
      "options": [
        { "value": "none", "label": "None" },
        { "value": "color", "label": "Color" },
        { "value": "gradient", "label": "Gradient" },
        { "value": "image", "label": "Image" }
      ],
      "default": "none"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background color",
      "default": "#1D0930",
      "visible_if": "{{ section.settings.bg_type == 'color' }}"
    },
    {
      "type": "color_background",
      "id": "bg_gradient",
      "label": "Background gradient",
      "visible_if": "{{ section.settings.bg_type == 'gradient' }}"
    },
    {
      "type": "image_picker",
      "id": "bg_image",
      "label": "Background image",
      "visible_if": "{{ section.settings.bg_type == 'image' }}"
    }
  ],
  "blocks": [
    {
      "type": "why_point",
      "name": "Section Points",
      "settings": [
        {
          "type": "header",
          "content": "Add point detail's"
        },
        {
          "type": "text",
          "id": "point_title",
          "default": "Point Title",
          "label": "Add point title"
        },
        {
          "type": "text",
          "id": "point_desc",
          "default": "Point Description....",
          "label": "Add point description"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Why Choose Section"
    }
  ]
}
{% endschema %}
