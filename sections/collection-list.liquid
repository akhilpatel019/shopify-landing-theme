{% render 'section-styles', section: section %}

{{ 'featured_collection.css' | asset_url | stylesheet_tag }}



<section class="featured_collection"> 
<div class="page_width">
  

    {% assign featured_collection = section.settings.collection  %}

    {% if featured_collection != blank %}
  <div class="featured-products">

  {% assign products = featured_collection.products |  reverse %}

    {% for product in products limit: section.settings.products_to_show  %}

    <div class="product-card">

  {% if product.featured_image != blank %}
    <a href="{{ product.url }}">
      {{
        product.featured_image
        | image_url: width: 600
        | image_tag: alt: product.title, loading: 'lazy'
      }}
    </a>
  {% endif %}

  <div class="product-info {% unless product.metafields.custom.show_price.value %}price-hidden{% endunless %}">
   <h3>{{ product.title }}</h3>

  {% if product.metafields.custom.show_price.value %}
    <p>{{ product.price | money }}</p>
  {% endif %}
 </div>

</div>

    {% endfor %}

  </div>
{% endif %}

</div>
</section>



{% schema %}
{
  "name": "Featured Collection",
  "settings": [
    {
      "type": "collection",
      "id": "collection",
      "label": "Select collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "Products to show",
      "min": 2,
      "max": 12,
      "step": 1,
      "default": 4
    },
     {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top (desktop)",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 12
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom (desktop)",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 12
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Padding top (mobile)",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 8
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Padding bottom (mobile)",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 8
    },
    {
      "type": "header",
      "content": "Background"
    },
    {
      "type": "select",
      "id": "bg_type",
      "label": "Background type",
      "options": [
        { "value": "none", "label": "None" },
        { "value": "color", "label": "Color" },
        { "value": "gradient", "label": "Gradient" },
        { "value": "image", "label": "Image" }
      ],
      "default": "color"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background color",
      "default": "#1D0930",
      "visible_if": "{{ section.settings.bg_type == 'color' }}"
    },
    {
      "type": "color_background",
      "id": "bg_gradient",
      "label": "Background gradient",
      "visible_if": "{{ section.settings.bg_type == 'gradient' }}"
    },
    {
      "type": "image_picker",
      "id": "bg_image",
      "label": "Background image",
      "visible_if": "{{ section.settings.bg_type == 'image' }}"
    }
  ],
  "presets": [
    {
      "name": "Featured Collection"
    }
  ]
}
{% endschema %}