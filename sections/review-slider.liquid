{% render 'section-styles', section: section %}
{{ 'review-slider.css' | asset_url | stylesheet_tag }}


 
<section class="review-section">


  <div class="page_width review-slide-heading">
    {% assign title = section.settings.section_title %}
    {% assign italic_word = section.settings.italic_word %}

    {% if italic_word != blank %}
      {% capture italic_tag %}<em>{{ italic_word }}</em>{% endcapture %}
      {% assign italic_title = title | replace: italic_word, italic_tag %}
    {% else %}
      {% assign italic_title = title %}
    {% endif %}

    <h2 class="section_header_title text-center">
      {{ italic_title }}
    </h2>
  </div>


  <div class="review-swiper">
  <div class="swiper-wrapper">

    {% for block in section.blocks %}
  {% if block.type == 'review-slide' %}
    {% render 'review-card', block: block %}
  {% endif %}
{% endfor %}

  </div>
  </div>


</section>


<script src="{{ 'review-slider.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Review card's slider",
  "tag": "section",
  "settings": [
    {
      "type": "header",
      "content": "Poster text content"
    },
    {
      "type": "text",
      "default": "Why they keep reordering",
      "id": "section_title",
      "label": "Add section title"
    },

    {
      "type": "text",
      "default": "reordering",
      "id": "italic_word",
      "label": "Word to make italic"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top (desktop)",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 12
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom (desktop)",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 12
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Padding top (mobile)",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 8
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Padding bottom (mobile)",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 8
    },
    {
      "type": "header",
      "content": "Background"
    },
    {
      "type": "select",
      "id": "bg_type",
      "label": "Background type",
      "options": [
        { "value": "none", "label": "None" },
        { "value": "color", "label": "Color" },
        { "value": "gradient", "label": "Gradient" },
        { "value": "image", "label": "Image" }
      ],
      "default": "none"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background color",
      "default": "#1D0930",
      "visible_if": "{{ section.settings.bg_type == 'color' }}"
    },
    {
      "type": "color_background",
      "id": "bg_gradient",
      "label": "Background gradient",
      "visible_if": "{{ section.settings.bg_type == 'gradient' }}"
    },
    {
      "type": "image_picker",
      "id": "bg_image",
      "label": "Background image",
      "visible_if": "{{ section.settings.bg_type == 'image' }}"
    }
  ],
  "blocks": [
    {
      "type": "review-slide",
      "name": "Review slide",
      "settings": [
        {
          "type": "header",
          "content": "Slider settings"
        },
        {
          "type": "range",
          "default": 1,
          "id": "rating_count",
          "label": "Set rating",
          "step": 1,
          "max": 5,
          "min": 1
        },
        {
          "type": "textarea",
          "id": "rating_msg",
          "label": "Tell about your experience"
        },
        {
          "type": "text",
          "id": "username",
          "label": "Add your username"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Review card's slider"
    }
  ]
}
{% endschema %}
