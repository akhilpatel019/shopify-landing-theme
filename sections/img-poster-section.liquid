{% render 'section-styles', section: section %}

{{ 'poster.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign wrapper_poster_mob = '#shopify-section-' | append: section.id
-%}

{% style  %} 


@media (max-width: 480px) {
{{ wrapper_poster_mob }} {
  background-image: url('{{ section.settings.bg_image_mob | image_url: width: 1200 }}') !important;
}
}
{% endstyle %}



<section class="poster-section">
<div class="page_width">
  
<div class="poster_inner">
{% assign title = section.settings.section_title %}
{% assign italic_word = section.settings.italic_word %}

{% if italic_word != blank %}
  {% capture italic_tag %}<em>{{ italic_word }}</em>{% endcapture %}
  {% assign italic_title = title | replace: italic_word, italic_tag %}
{% else %}
  {% assign italic_title = title %}
{% endif %}

<h2 class="section_header_title">
  {{ italic_title }}
</h2>

<p>{{section.settings.poster_desc}}</p>

{% if section.settings.btn_url != blank %}

<a class="btn-fill" href="{{section.settings.btn_url}}">{{section.settings.btn_text}}</a>

{% endif %}
</div>


</div>
</section>





{%  schema  %} 
{
    "name":"Poster Section",
    "tag": "section",
    "settings": [
        {
            "type": "header",
            "content": "Poster text content"
        },
         {
      "type": "text",
      "default": "More than electrolytes.",
      "id": "section_title",
      "label": "Add section title"
    },

    {
      "type": "text",
      "default": "electrolytes.",
      "id": "italic_word",
      "label": "Word to make italic"
    },
        {
            "type": "textarea",
             "default": "Poster Description....",
            "id": "poster_desc",
            "label": "Add description"
        },
        {
            "type": "url",
            "id": "btn_url",
            "label": "Set button link"
        },
        {
            "type": "text",
            "default": "Click",
            "id": "btn_text",
            "label": "Add button text"
        },

          {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top (desktop)",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 12
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom (desktop)",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 12
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Padding top (mobile)",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 8
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Padding bottom (mobile)",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 8
    },
    {
      "type": "header",
      "content": "Background"
    },
    {
      "type": "select",
      "id": "bg_type",
      "label": "Background type",
      "options": [
        { "value": "none", "label": "None" },
        { "value": "color", "label": "Color" },
        { "value": "gradient", "label": "Gradient" },
        { "value": "image", "label": "Image" }
      ],
      "default": "image"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background color",
      "default": "#1D0930",
      "visible_if": "{{ section.settings.bg_type == 'color' }}"
    },
    {
      "type": "color_background",
      "id": "bg_gradient",
      "label": "Background gradient",
      "visible_if": "{{ section.settings.bg_type == 'gradient' }}"
    },
    {
      "type": "image_picker",
      "id": "bg_image",
      "label": "Background image",
      "visible_if": "{{ section.settings.bg_type == 'image' }}"
    },
    {
        "type": "image_picker",
      "id": "bg_image_mob",
      "label": "Set background image for mobile screen"
    }
    ],
    "blocks": [],
    "presets": [
        {
            "name": "Poster Section"
        }
    ]
}
{% endschema %} 