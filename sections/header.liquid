{% render 'section-styles', section: section %}

 {{ 'header.css' | asset_url | stylesheet_tag }}




<header class="main-header">
  <div class="header_wrapper">

    <nav class="page_header page_width">

      <div class="header-left">

    {% assign left_menu = section.settings.header_left_side_menu %} 

    {% for link in left_menu.links %}
        <a href="{{link.url}}">
            {{link.title |  upcase }}
        </a>
        {% endfor %}

      </div>

      <div class="header-logo-wrapper">

      <a href="{{ routes.root_url }}">
  {% if section.settings.header_logo != blank %}
    {{
      section.settings.header_logo
      | image_url: width: 300
      | image_tag: alt: shop.name, class: 'header-logo'
    }}
  {% endif %}
</a>

      </div>

      <div class="header-right">
        {% assign right_menu = section.settings.header_right_side_menu %} 

         {% for link in right_menu.links %}
        <a href="{{link.url}}">
            {{link.title |  upcase}}
        </a>
        {% endfor %}

         <a href="#">
           Cart(0)
        </a>

      </div>


      <button class="menu-toggle" aria-label="Open menu">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="#1D0930" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="3" y1="6" x2="21" y2="6"/>
          <line x1="3" y1="12" x2="21" y2="12"/>
          <line x1="3" y1="18" x2="21" y2="18"/>
        </svg>
      </button>
    </nav>

  </div>

  <div class="menu-overlay" id="menuOverlay"></div>
  <div class="offcanvas-menu" id="offcanvasMenu">
    <div class="offcanvas-header">
       {% if section.settings.mobile_menu_logo != blank %}
    {{
      section.settings.mobile_menu_logo
      | image_url: width: 200
      | image_tag: alt: shop.name, class: 'offcanvas-logo'
    }}
       {% endif %}
      <button class="close-menu" id="closeMenu" aria-label="Close menu">&times;</button>
    </div>
    <div class="offcanvas-links">

    {% assign mobile_menu  = section.settings.mobile_menu.links %}
    {% for link in mobile_menu %}
 <a href="{{link.url}}">{{link.title}}</a>
      {% endfor %}
      <a href="#">cart (0)</a>
    </div>
  </div>

 





</header>


<script src="{{ 'mobile_menu.js' | asset_url }}" defer></script>



{% schema %}
  {
    "name": "Header",
    "tag": "header",
    "settings": [
      {
        "type": "header",
        "content": "Header settings"
      },
       {
      "type": "font_picker",
      "label": "Slect header font",
      "id": "header_font",
      "default": "sans-serif"
    },

       {
      "type": "link_list",
      "label": "Select left side menu",
      "id": "header_left_side_menu"
    },

    {
      "type": "image_picker",
      "label": "Select header logo",
      "id": "header_logo"
    },
    {
      "type": "link_list",
      "label": "Select right side menu",
      "id": "header_right_side_menu"
    },
      {
        "type": "header",
        "content": "Spacing"
      },
      {
        "type": "range",
        "id": "padding_top",
        "label": "Padding top (desktop)",
        "min": 0, "max": 200, "step": 4, "unit": "px", "default": 0
      },
      {
        "type": "range",
        "id": "padding_bottom",
        "label": "Padding bottom (desktop)",
        "min": 0, "max": 200, "step": 4, "unit": "px", "default": 0
      },
      {
        "type": "range",
        "id": "padding_top_mobile",
        "label": "Padding top (mobile)",
        "min": 0, "max": 200, "step": 4, "unit": "px", "default": 0
      },
      {
        "type": "range",
        "id": "padding_bottom_mobile",
        "label": "Padding bottom (mobile)",
        "min": 0, "max": 200, "step": 4, "unit": "px", "default": 0
      },
      {
        "type": "header",
        "content": "Background"
      },
      {
        "type": "select",
        "id": "bg_type",
        "label": "Background type",
        "options": [
          { "value": "none", "label": "None" },
          { "value": "color", "label": "Color" },
          { "value": "gradient", "label": "Gradient" },
          { "value": "image", "label": "Image" }
        ],
        "default": "none"
      },
      {
        "type": "color",
        "id": "bg_color",
        "label": "Background color",
        "default": "#FDF6F4",
        "visible_if": "{{ section.settings.bg_type == 'color' }}"
      },
      {
        "type": "color_background",
        "id": "bg_gradient",
        "label": "Background gradient",
        "visible_if": "{{ section.settings.bg_type == 'gradient' }}"
      },
      {
        "type": "image_picker",
        "id": "bg_image",
        "label": "Background image",
        "visible_if": "{{ section.settings.bg_type == 'image' }}"
      },

      {
        "type": "header",
        "content": "Mobile header Settings"
      },
      {
      "type": "image_picker",
      "label": "Select mobile menu logo",
      "id": "mobile_menu_logo"
      },
      {
      "type": "link_list",
      "label": "Select mobile menu",
      "id": "mobile_menu"
      }

    ],
    "presets": [
      {
        "name": "Header"
      }
    ]
  }
{% endschema %}