<div class="swiper-slide" {{block.shopify_attributes}}>
  <div class="review-slide-content">
    <div class="r-text">

      <div class="review-stars">
        {% for i in (1..5) %}
          <svg
            width="20"
            height="21"
            viewBox="0 0 20 21"
            fill="none"
            xmlns="http://www.w3.org/2000/svg"
          >
            <path
              d="M9.45892 1.31164C9.72371 0.775106 10.4888 0.775106 10.7536 1.31164L12.9084 5.67786C13.0136 5.89092 13.2168 6.03859 13.452 6.07276L18.2704 6.77292C18.8625 6.85895 19.0989 7.58658 18.6705 8.00421L15.1838 11.4028C15.0137 11.5687 14.936 11.8076 14.9762 12.0418L15.7993 16.8407C15.9004 17.4305 15.2815 17.8802 14.7519 17.6017L10.4422 15.336C10.2319 15.2254 9.98063 15.2254 9.77033 15.336L5.46061 17.6017C4.93102 17.8802 4.31206 17.4302 4.4132 16.8407L5.23629 12.0418C5.27645 11.8076 5.19881 11.5687 5.02868 11.4028L1.54204 8.00421C1.11359 7.58658 1.35002 6.85895 1.94211 6.77292L6.76053 6.07276C6.99565 6.03859 7.19891 5.89092 7.30406 5.67786L9.45892 1.31164Z"
              fill="{% if i <= block.settings.rating_count %}#4E2870{% else %}#D9D9D9{% endif %}"
            />
          </svg>
        {% endfor %}
      </div>

      <p>“{{ block.settings.rating_msg }}”</p>
    </div>

    <div class="review-user-name">
      <p>{{ block.settings.username }}</p>
    </div>
  </div>
</div>